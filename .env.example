# Copy to .env when you want to override these local defaults.
# If .env is missing, the API reads this file. Do not put real secrets here.

# PostgreSQL. The password matches the local Compose default and is not a production secret.
DATABASE_URL=postgresql://s4n:s4n_dev_password@localhost:5432/s4n

# 32-byte AES-256 key, standard base64.
# Generate a real one with: openssl rand -base64 32
# The value below is 32 zero bytes. The API rejects it when S4N_ENV=production.
S4N_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# development | test | production
S4N_ENV=development

# Browser origin allowed to call cookie-authenticated mutations.
S4N_DASHBOARD_ORIGIN=http://localhost:5180

# OBS overlay origin. The dashboard builds browser-source URLs from this.
S4N_OVERLAY_ORIGIN=http://localhost:5181

# Public origin of this API. ECPay and O'Pay callback and browser-return URLs are built from it.
# Required when S4N_ENV=production. No path. Use https on port 443 in production;
# the providers will not notify a non-public host or a custom port.
# S4N_PUBLIC_BASE_URL=https://donate.example

# Integer TWD bounds for the public donate form.
# S4N_DONATION_MIN_TWD=30
# S4N_DONATION_MAX_TWD=20000

# Event log retention. Chat is separate from donations. No secrets belong here.
# S4N_EVENT_RETENTION_DAYS=7
# S4N_EVENT_CHAT_RETENTION_HOURS=24
# S4N_EVENT_CLEANUP_INTERVAL_MINUTES=15
# S4N_EVENT_REPLAY_LIMIT=200

PORT=8787

# The browser calls /api and /ws on the page's own origin.
# Vite dev, the nginx image, and Caddy all proxy those paths. Leave this unset
# so a production build does not bake in localhost:8787.
# VITE_API_URL=

# Production (compose.prod.yaml). Leave these commented for local development.
# Passwords must be URL-safe; use: openssl rand -hex 24
# Master key: openssl rand -base64 32
# S4N_ENV is forced to production by compose.prod.yaml.
# POSTGRES_USER=s4n
# POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
# POSTGRES_DB=s4n
# S4N_MASTER_KEY=replace-with-openssl-rand-base64-32
# S4N_DOMAIN=donate.example
# S4N_OVERLAY_HOST=overlay.donate.example
# S4N_DASHBOARD_ORIGIN=https://donate.example
# S4N_OVERLAY_ORIGIN=https://overlay.donate.example
# S4N_PUBLIC_BASE_URL=https://donate.example
# S4N_TLS_MODE=acme
# S4N_ACME_EMAIL=ops@example.com
# S4N_BACKUP_RETENTION=14
# S4N_IMAGE_TAG=latest
# Optional docs host. Also start with: docker compose -f compose.prod.yaml --profile docs up -d
# S4N_DOCS_HOST=docs.donate.example
