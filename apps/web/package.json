{
  "name": "@s4n/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5180 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/overlay-preview.test.ts"
  },
  "dependencies": {
    "@s4n/design-tokens": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.1",
    "tocas": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
