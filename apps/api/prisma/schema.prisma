generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Operator account. Passwords are stored only as Argon2id hashes.
/// The overlay token is sealed with the master key. Lookup uses the hash.
model Operator {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  overlayTokenHash   String?   @unique
  overlayCiphertext  Bytes?
  overlayIv          Bytes?
  overlayAuthTag     Bytes?
  sessions           Session[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Opaque server-side session. The cookie stores only this id.
model Session {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([operatorId])
}

model PluginInstallation {
  id             String                   @id
  enabled        Boolean                  @default(false)
  version        String
  publicSettings Json                     @default("{}")
  secrets        EncryptedPluginSetting[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  installed      Boolean                  @default(true)
  pinned         Boolean                  @default(false)
  source         String                   @default("official")
  sha256         String                   @default("")
  previousVersion String?
  previousSha256  String?
  permissions    Json                     @default("[]")
}

/// Plugin secrets sealed with AES-256-GCM under S4N_MASTER_KEY.
/// Dashboard reads never select these columns.
model EncryptedPluginSetting {
  id         String             @id @default(cuid())
  pluginId   String
  plugin     PluginInstallation @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  fieldKey   String
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([pluginId, fieldKey])
}

/// Core donation ledger. Payment plugins do not write this table.
/// donorName and message are untrusted donor input.
model Donation {
  id          String         @id @default(cuid())
  providerId  String
  providerRef String?
  amountMinor Int
  currency    String
  status      DonationStatus
  donorName   String
  message     String
  expiresAt   DateTime?
  bankCode    String?
  payCode     String?
  barcode1    String?
  barcode2    String?
  barcode3    String?
  paymentType String?
  reviewNotice Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([providerId, providerRef])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

enum DonationStatus {
  created
  succeeded
  failed
  awaiting
  expired
  review
}

/// Append-only delivery log. This is not the donation ledger.
/// `s4n.donation.test` is stored here and must never create a Donation row.
/// `donationId` is a dedupe key for `s4n.donation.*` only. It is not a foreign key.
/// Retention is the only delete. `sequence` is never reused.
model EventLog {
  sequence   BigInt   @id @default(autoincrement())
  eventId    String   @unique
  type       String
  donationId String?
  payload    Json
  createdAt  DateTime

  @@unique([type, donationId])
  @@index([createdAt])
  @@index([type, createdAt])
}
