{
  "name": "@s4n/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/crypto/master-key.test.ts src/crypto/secret-box.test.ts src/auth/origin.test.ts src/plugins/manifests.test.ts src/plugins/permissions.test.ts src/plugins/settings.test.ts src/payments/ledger.test.ts src/payments/callback.test.ts src/payments/donations.test.ts src/realtime/plugin-bus.test.ts src/events.contract.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@s4n/events": "workspace:*",
    "@s4n/plugin-alerts": "workspace:*",
    "@s4n/plugin-ecpay": "workspace:*",
    "@s4n/plugin-goals": "workspace:*",
    "@s4n/plugin-opay": "workspace:*",
    "@s4n/plugin-sdk": "workspace:*",
    "@s4n/plugin-ticker": "workspace:*",
    "@s4n/plugin-tts": "workspace:*",
    "dotenv": "^18.0.0",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
