{
  "name": "s4n-donate-system-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salmon4neko-Studio/S4N-Donate-System-2.0.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "pnpm --parallel --filter s4n-donate-system-2.0-api --filter s4n-donate-system-2.0-web --filter s4n-donate-system-2.0-overlay --filter s4n-donate-system-2.0-docs dev",
    "typecheck": "pnpm db:generate && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter s4n-donate-system-2.0-api db:generate",
    "db:migrate": "pnpm --filter s4n-donate-system-2.0-api db:migrate",
    "db:deploy": "pnpm --filter s4n-donate-system-2.0-api db:deploy"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
